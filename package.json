{
  "name": "fantasy-platform",
  "version": "1.0.0",
  "description": "Custom fantasy football platform with advanced scoring customization",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter api test",
    "test:watch": "pnpm --filter api test:watch",
    "db:generate": "pnpm --filter @fantasy-platform/database db:generate",
    "db:migrate": "pnpm --filter @fantasy-platform/database db:migrate",
    "db:push": "pnpm --filter @fantasy-platform/database db:push",
    "db:studio": "pnpm --filter @fantasy-platform/database db:studio",
    "db:seed": "pnpm --filter @fantasy-platform/database db:seed"
  },
  "keywords": [
    "fantasy-football",
    "scoring",
    "sports"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.0",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.0.2",
    "prettier": "^3.4.2"
  }
}
